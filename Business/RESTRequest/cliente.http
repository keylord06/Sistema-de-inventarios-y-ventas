@host = http://localhost:9090/api
@uri = {{host}}/cliente
@token = pegar-aqui-el-token-del-login

GET {{uri}}
Authorization: Bearer {{token}}
###

GET {{uri}}/filter/0/10?nombre=perez
Authorization: Bearer {{token}}
###

POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "cedula": "1-2345-6789",
    "nombre_completo": "Juan Pérez",
    "telefono": "8888-1111",
    "email": "juan@correo.com"
}
###

PUT {{uri}}/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "telefono": "8888-2222"
}
###

DELETE {{uri}}/1
Authorization: Bearer {{token}}
###
