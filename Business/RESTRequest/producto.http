@host = http://localhost:9090/api
@uri = {{host}}/producto
@token = pegar-aqui-el-token-del-login

GET {{uri}}
Authorization: Bearer {{token}}
###

GET {{uri}}/filter/0/10?nombre=aceite
Authorization: Bearer {{token}}
###

GET {{uri}}/stock-bajo
Authorization: Bearer {{token}}
###

POST {{uri}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "PRD-100",
    "nombre": "Aceite 1L",
    "categoria_id": 1,
    "proveedor_id": 1,
    "precio": 1500,
    "stock": 20,
    "stock_minimo": 5
}
###

POST {{uri}}/1/entrada
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "cantidad": 10
}
###

PUT {{uri}}/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "precio": 1600
}
###

DELETE {{uri}}/1
Authorization: Bearer {{token}}
###
